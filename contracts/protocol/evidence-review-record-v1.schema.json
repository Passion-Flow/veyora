{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyora.invalid/contracts/protocol/evidence-review-record-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "reviewer_key_id", "reviewer_identity", "reviewer_qualification", "approved_disposition", "corpus_id", "fixture_id", "generator_source_sha256", "review_subject_sha256", "review_output", "review_output_sha256", "approval_preimage_hex", "approval_signature_hex"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "veyora-independent-evidence-review-v1"},
    "reviewer_key_id": {"type": "string", "pattern": "^reviewer-[a-z0-9][a-z0-9-]{0,126}$"},
    "reviewer_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "reviewer_qualification": {"const": "independent-cryptography-evidence-reviewer"},
    "approved_disposition": {"const": "qualified-human-approved"},
    "corpus_id": {"enum": ["project-crypto-v1", "native-backup-v1", "manifest-v1"]},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "generator_source_sha256": {"$ref": "#/$defs/sha256"},
    "review_subject_sha256": {"$ref": "#/$defs/sha256"},
    "review_output": {"$ref": "#/$defs/reviewOutput"},
    "review_output_sha256": {"$ref": "#/$defs/sha256"},
    "approval_preimage_hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "approval_signature_hex": {"type": "string", "pattern": "^(?!0{128}$)[0-9a-f]{128}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "reviewOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reviewed_at", "notes"],
      "properties": {
        "decision": {"const": "approved-for-task5-independent-evidence"},
        "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "notes": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
