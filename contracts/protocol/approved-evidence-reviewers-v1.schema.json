{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyora.invalid/contracts/protocol/approved-evidence-reviewers-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_type",
    "attestation_policy",
    "governance",
    "reviewers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_type": {
      "const": "veyora-approved-evidence-reviewers-v1"
    },
    "attestation_policy": {
      "const": "owner-authenticated-out-of-band-human-attestation-only"
    },
    "governance": {
      "const": "owner-authorized-manual-registration-only"
    },
    "reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    }
  },
  "$defs": {
    "reviewer": {
      "oneOf": [
        {
          "$ref": "#/$defs/cryptographyReviewer"
        },
        {
          "$ref": "#/$defs/softwareLicenseReviewer"
        },
        {
          "$ref": "#/$defs/containerImageReviewer"
        },
        {
          "$ref": "#/$defs/managedPostgresqlReviewer"
        }
      ]
    },
    "cryptographyReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "reviewer_identity",
        "attestation_type",
        "qualification",
        "status",
        "scopes",
        "verification_key_hex"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^reviewer-[a-z0-9][a-z0-9-]{0,126}$"
        },
        "reviewer_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attestation_type": {
          "const": "owner-attested-qualified-human"
        },
        "qualification": {
          "const": "independent-cryptography-evidence-reviewer"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "project-crypto-v1",
              "native-backup-v1",
              "manifest-v1",
              "kernel-wasm-product-binding-v1"
            ]
          }
        },
        "verification_key_hex": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    },
    "softwareLicenseReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "reviewer_identity",
        "attestation_type",
        "qualification",
        "status",
        "scopes",
        "verification_key_hex"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^reviewer-[a-z0-9][a-z0-9-]{0,126}$"
        },
        "reviewer_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attestation_type": {
          "const": "owner-attested-qualified-human"
        },
        "qualification": {
          "const": "qualified-software-license-reviewer"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "js-dependency-license-v1"
            ]
          }
        },
        "verification_key_hex": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    },
    "containerImageReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "reviewer_identity",
        "attestation_type",
        "qualification",
        "status",
        "scopes",
        "verification_key_hex"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^reviewer-[a-z0-9][a-z0-9-]{0,126}$"
        },
        "reviewer_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attestation_type": {
          "const": "owner-attested-qualified-human"
        },
        "qualification": {
          "const": "qualified-container-image-evidence-reviewer"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "image-policy-v1"
            ]
          }
        },
        "verification_key_hex": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    },
    "managedPostgresqlReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "reviewer_identity",
        "attestation_type",
        "qualification",
        "status",
        "scopes",
        "verification_key_hex"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^reviewer-[a-z0-9][a-z0-9-]{0,126}$"
        },
        "reviewer_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attestation_type": {
          "const": "owner-attested-qualified-human"
        },
        "qualification": {
          "const": "qualified-managed-postgresql-evidence-reviewer"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "managed-postgresql-profile-v1"
            ]
          }
        },
        "verification_key_hex": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    }
  }
}
