{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyora.invalid/contracts/backup/backup-vector-corpus-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "provenance_contract", "canonical_hash_rule", "libsodium_version", "oracle_evidence", "fixtures"],
  "properties": {
    "schema_version": {"const": 1},
    "corpus_id": {"const": "native-backup-v1"},
    "provenance_contract": {"const": "contracts/protocol/vector-provenance-v1.json"},
    "canonical_hash_rule": {"const": "veyora-vector-json-v1"},
    "libsodium_version": {"const": "1.0.22"},
    "oracle_evidence": {"$ref": "#/$defs/oracleEvidence"},
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream-fixed-decrypt", "empty", "one-byte", "exact-chunk", "multi-chunk"],
      "properties": {
        "upstream-fixed-decrypt": {
          "oneOf": [
            {"$ref": "#/$defs/blockedUpstreamFixture"},
            {"$ref": "#/$defs/capturedUpstreamFixture"}
          ]
        },
        "empty": {"$ref": "#/$defs/fixture", "properties": {"case": {"const": "empty"}}},
        "one-byte": {"$ref": "#/$defs/fixture", "properties": {"case": {"const": "one-byte"}}},
        "exact-chunk": {"$ref": "#/$defs/fixture", "properties": {"case": {"const": "exact-chunk"}}},
        "multi-chunk": {"$ref": "#/$defs/fixture", "properties": {"case": {"const": "multi-chunk"}}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "upstreamGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "source_kind", "source_ref", "source_sha256", "capture_semantics"],
      "properties": {
        "owner": {"const": "upstream-secretstream-captured-vector-generator"},
        "source_kind": {"const": "upstream-url"},
        "source_ref": {"const": "https://raw.githubusercontent.com/pyca/pynacl/ecf41f55a3d8f1e10ce89c61c4b4d67f3f4467cf/docs/vectors/c-source/secretstream_test_vector.c"},
        "source_sha256": {"const": "911a361c92996c35f73e85e2258d848b4b43a3aba7030e4f070a0f148617e1b3"},
        "capture_semantics": {"const": "random-output-capture-not-deterministic-kat"}
      }
    },
    "projectGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "source_kind", "source_ref", "source_sha256"],
      "properties": {
        "owner": {"const": "standalone-c-libsodium-oracle"},
        "source_kind": {"const": "committed-file"},
        "source_ref": {"const": "security-kernel/oracles/secretstream-v1.c"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition"],
          "properties": {"disposition": {"const": "ai-non-human-reviewed"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "review_record_path", "review_record_sha256"],
          "properties": {
            "disposition": {"const": "qualified-human-reviewed"},
            "review_record_path": {"type": "string", "pattern": "^docs/security/reviews/native-backup-v1/[a-z0-9][a-z0-9-]*\\.review-v1\\.json$"},
            "review_record_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "inlineFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "tag", "aad_hex", "plaintext_hex", "ciphertext_hex"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "tag": {"enum": ["MESSAGE", "FINAL"]},
        "aad_hex": {"$ref": "#/$defs/hex"},
        "plaintext_hex": {"$ref": "#/$defs/hex"},
        "ciphertext_hex": {"$ref": "#/$defs/hex"}
      }
    },
    "ciphertextSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "path", "length", "sha256"],
      "properties": {
        "representation": {"const": "contained-regular-file"},
        "path": {"type": "string", "pattern": "^security-kernel/vectors/backup-v1/(empty|one-byte|exact-chunk|multi-chunk)/frame-[0-9]{3}\\.ciphertext\\.bin$"},
        "length": {"const": 4194321},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "plaintextRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "logical_offset", "logical_bytes", "padding_bytes", "padding_generator", "padding_seed_hex"],
      "properties": {
        "id": {"const": "zero-logical-then-libsodium-deterministic-padding-v1"},
        "logical_offset": {"type": "integer", "minimum": 0},
        "logical_bytes": {"type": "integer", "minimum": 0},
        "padding_bytes": {"type": "integer", "minimum": 0},
        "padding_generator": {"const": "libsodium-randombytes-buf-deterministic-1.0.22"},
        "padding_seed_hex": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"}
      }
    },
    "dataFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "tag", "aad_hex", "plaintext_recipe", "plaintext_length", "plaintext_sha256", "ciphertext_sidecar"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "tag": {"const": "MESSAGE"},
        "aad_hex": {"$ref": "#/$defs/hex"},
        "plaintext_recipe": {"$ref": "#/$defs/plaintextRecipe"},
        "plaintext_length": {"const": 4194304},
        "plaintext_sha256": {"$ref": "#/$defs/sha256"},
        "ciphertext_sidecar": {"$ref": "#/$defs/ciphertextSidecar"}
      }
    },
    "finalFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "tag", "aad_hex", "plaintext_hex", "ciphertext_hex"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "tag": {"const": "FINAL"},
        "aad_hex": {"$ref": "#/$defs/hex"},
        "plaintext_hex": {"$ref": "#/$defs/hex"},
        "ciphertext_hex": {"$ref": "#/$defs/hex"}
      }
    },
    "oracleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_sha256", "sidecar_sha256", "minisign_public_key",
        "minisign_verifier_source_ref", "minisign_verifier_source_sha256",
        "minisign_verifier_manifest_sha256", "minisign_verifier_lock_sha256",
        "minisign_verifier_binary_sha256", "minisign_verifier_build_command",
        "minisign_verification_command", "generator_source_ref",
        "generator_source_sha256", "generator_binary_sha256", "checker_source_ref",
        "checker_source_sha256", "checker_binary_sha256", "transcriber_source_ref",
        "transcriber_source_sha256", "compiler_command", "compiler_version",
        "compiler_version_sha256", "archiver_command", "archiver_version",
        "archiver_version_sha256", "source_build_command", "generator_link_command",
        "checker_link_command", "network_isolation", "source_build_mode",
        "linked_library_sha256", "ciphertext_digest_catalog_sha256",
        "oracle_evidence_sha256"
      ],
      "properties": {
        "archive_sha256": {"const": "0dead67e534e4e14302d9f285fb68688f18ee93fb35350ac05214dd7772ab534"},
        "sidecar_sha256": {"const": "9ed6444f7bb2a0b052d872062d398417262d544f65ee42be1df2a956469c07fe"},
        "minisign_public_key": {"const": "RWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3"},
        "minisign_verifier_source_ref": {"const": "security-kernel/oracles/minisign-verifier/src/main.rs"},
        "minisign_verifier_source_sha256": {"$ref": "#/$defs/sha256"},
        "minisign_verifier_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "minisign_verifier_lock_sha256": {"$ref": "#/$defs/sha256"},
        "minisign_verifier_binary_sha256": {"$ref": "#/$defs/sha256"},
        "minisign_verifier_build_command": {"type": "string", "minLength": 1},
        "minisign_verification_command": {"type": "string", "minLength": 1},
        "generator_source_ref": {"const": "security-kernel/oracles/secretstream-v1.c"},
        "generator_source_sha256": {"$ref": "#/$defs/sha256"},
        "generator_binary_sha256": {"$ref": "#/$defs/sha256"},
        "checker_source_ref": {"const": "security-kernel/oracles/check-secretstream-v1.c"},
        "checker_source_sha256": {"$ref": "#/$defs/sha256"},
        "checker_binary_sha256": {"$ref": "#/$defs/sha256"},
        "transcriber_source_ref": {"const": "security-kernel/oracles/generate-backup-v1.py"},
        "transcriber_source_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_command": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1},
        "compiler_version_sha256": {"$ref": "#/$defs/sha256"},
        "archiver_command": {"type": "string", "minLength": 1},
        "archiver_version": {"type": "string", "minLength": 1},
        "archiver_version_sha256": {"$ref": "#/$defs/sha256"},
        "source_build_command": {"type": "string", "minLength": 1},
        "generator_link_command": {"type": "string", "minLength": 1},
        "checker_link_command": {"type": "string", "minLength": 1},
        "network_isolation": {"const": "linux-unshare-network-namespace"},
        "source_build_mode": {"const": "fresh-controlled-directory"},
        "linked_library_sha256": {"const": "2b082ef330e43ccbb7db83fe0bbf8d3ee5b038bbc088b7dd8d09609dcf67c859"},
        "ciphertext_digest_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "blockedUpstreamFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "evidence_status", "source_document", "source_section", "provenance_id", "oracle_kind", "generator", "blocker"],
      "properties": {
        "case": {"const": "upstream-fixed-decrypt"},
        "evidence_status": {"const": "blocked-pending-captured-output-and-qualified-review"},
        "source_document": {"const": "PyNaCl 1.6.2 secretstream reference vectors"},
        "source_section": {"const": "Vector generation"},
        "provenance_id": {"const": "native-backup-v1"},
        "oracle_kind": {"const": "upstream-captured-random-decrypt"},
        "generator": {"$ref": "#/$defs/upstreamGenerator"},
        "blocker": {"const": "libsodium-1.0.22-publishes-no-fixed-secretstream-reference-data"}
      }
    },
    "capturedUpstreamFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "source_document", "source_section", "provenance_id", "oracle_kind", "generator", "generation_command", "library_archive_sha256", "linked_library_sha256", "oracle_evidence_sha256", "key_hex", "stream_header_hex", "frames", "transcript_sha256", "independent_pull_checker_source_sha256", "independent_pull_verification", "fixture_sha256", "review"],
      "properties": {
        "case": {"const": "upstream-fixed-decrypt"},
        "source_document": {"type": "string", "minLength": 1},
        "source_section": {"type": "string", "minLength": 1},
        "provenance_id": {"const": "native-backup-v1"},
        "oracle_kind": {"const": "upstream-captured-random-decrypt"},
        "generator": {"$ref": "#/$defs/upstreamGenerator"},
        "generation_command": {"type": "string", "minLength": 1},
        "library_archive_sha256": {"const": "0dead67e534e4e14302d9f285fb68688f18ee93fb35350ac05214dd7772ab534"},
        "linked_library_sha256": {"const": "2b082ef330e43ccbb7db83fe0bbf8d3ee5b038bbc088b7dd8d09609dcf67c859"},
        "oracle_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "key_hex": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
        "stream_header_hex": {"type": "string", "pattern": "^(?!0{48}$)[0-9a-f]{48}$"},
        "frames": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/inlineFrame"}},
        "transcript_sha256": {"$ref": "#/$defs/sha256"},
        "independent_pull_checker_source_sha256": {"$ref": "#/$defs/sha256"},
        "independent_pull_verification": {"const": "independent-secretstream-pull-pass"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case", "source_document", "source_section", "provenance_id", "oracle_kind",
        "generator", "generation_command", "library_archive_sha256", "linked_library_sha256",
        "oracle_evidence_sha256", "golden_source_path", "golden_source_sha256",
        "logical_size", "data_chunk_count", "chunk_plaintext_bytes",
        "logical_snapshot_recipe", "logical_snapshot_sha256", "key_hex",
        "stream_header_hex", "backup_header_cbor_hex", "backup_header_sha256",
        "frames", "fixture_sha256", "review"
      ],
      "properties": {
        "case": {"enum": ["empty", "one-byte", "exact-chunk", "multi-chunk"]},
        "source_document": {"const": "docs/adr/0001-cryptographic-protocol.md"},
        "source_section": {"const": "encrypted-backup-v1, checkpoint, and artifact receipt"},
        "provenance_id": {"const": "native-backup-v1"},
        "oracle_kind": {"const": "project-independent-c"},
        "generator": {"$ref": "#/$defs/projectGenerator"},
        "generation_command": {"type": "string", "minLength": 1},
        "library_archive_sha256": {"const": "0dead67e534e4e14302d9f285fb68688f18ee93fb35350ac05214dd7772ab534"},
        "linked_library_sha256": {"const": "2b082ef330e43ccbb7db83fe0bbf8d3ee5b038bbc088b7dd8d09609dcf67c859"},
        "oracle_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "golden_source_path": {"type": "string", "pattern": "^contracts/backup/goldens/(empty|one-byte|exact-chunk|multi-chunk)\\.json$"},
        "golden_source_sha256": {"$ref": "#/$defs/sha256"},
        "logical_size": {"type": "integer", "minimum": 0},
        "data_chunk_count": {"type": "integer", "minimum": 1},
        "chunk_plaintext_bytes": {"const": 4194304},
        "logical_snapshot_recipe": {"const": "zero-bytes-of-logical-size"},
        "logical_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "key_hex": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
        "stream_header_hex": {"type": "string", "pattern": "^(?!0{48}$)[0-9a-f]{48}$"},
        "backup_header_cbor_hex": {"$ref": "#/$defs/hex"},
        "backup_header_sha256": {"$ref": "#/$defs/sha256"},
        "frames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"oneOf": [{"$ref": "#/$defs/dataFrame"}, {"$ref": "#/$defs/finalFrame"}]}
        },
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
