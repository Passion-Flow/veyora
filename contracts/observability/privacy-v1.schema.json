{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyora.invalid/contracts/observability/privacy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default", "metrics", "traces", "alerts", "forbidden", "export"],
  "properties": {
    "schema_version": {"const": 1},
    "default": {"const": "deny"},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "traces": {"type": "array", "items": {"type": "object"}},
    "alerts": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "object"}},
    "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "export": {"type": "object"}
  }
}
