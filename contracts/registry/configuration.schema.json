{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyora.invalid/contracts/registry/configuration.schema.json",
  "title": "Veyora configuration catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "settings"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setting"
      }
    }
  },
  "$defs": {
    "owner": {
      "enum": ["security-kernel", "backend", "frontend", "deployment"]
    },
    "classification": {
      "enum": [
        "build-time",
        "runtime-nonsensitive",
        "runtime-secret-file-reference",
        "encrypted-user-data",
        "protocol-invariant"
      ]
    },
    "valueKind": {
      "enum": [
        "boolean",
        "bytes",
        "duration-seconds",
        "hostname",
        "integer",
        "path",
        "secret-reference",
        "semver",
        "socket-address",
        "string",
        "string-list",
        "uri"
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/valueKind"
        },
        "reference_type": {
          "enum": ["mounted-file"]
        }
      }
    },
    "valuePolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "required"
            },
            "required_when": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "default"],
          "properties": {
            "mode": {
              "const": "default"
            },
            "default": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "value"],
          "properties": {
            "mode": {
              "const": "fixed"
            },
            "value": true
          }
        }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "minimum_items": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_items": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_length": {
          "type": "integer",
          "minimum": 1
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operational", "safety"],
      "properties": {
        "operational": {
          "$ref": "#/$defs/range"
        },
        "safety": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "logPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logs", "diagnostics", "support_bundles", "reason"],
      "properties": {
        "logs": {
          "enum": ["allowed", "redacted", "denied"]
        },
        "diagnostics": {
          "enum": ["allowed", "redacted", "denied"]
        },
        "support_bundles": {
          "enum": ["allowed", "redacted", "denied"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["active", "deprecated"]
        },
        "replacement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "migration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "classification",
        "description",
        "value",
        "value_policy",
        "bounds",
        "precedence",
        "reload",
        "log_policy",
        "deprecation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "value_policy": {
          "$ref": "#/$defs/valuePolicy"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "precedence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "command",
              "owner-file",
              "deployment-adapter",
              "secure-default",
              "secret-reference-file",
              "unlocked-vault",
              "protocol-contract"
            ]
          }
        },
        "reload": {
          "enum": [
            "build",
            "immediate",
            "new-session",
            "next-policy-sync",
            "restart",
            "removed-after-bootstrap"
          ]
        },
        "log_policy": {
          "$ref": "#/$defs/logPolicy"
        },
        "deprecation": {
          "$ref": "#/$defs/deprecation"
        }
      }
    }
  }
}
