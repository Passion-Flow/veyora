{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyora.invalid/contracts/registry/secret-references.schema.json",
  "title": "Veyora secret reference",
  "description": "A typed reference to a mounted secret file. Secret values are never valid members of this object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["setting_id", "file"],
  "properties": {
    "setting_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "file": {
      "type": "string",
      "pattern": "^/run/secrets/[a-z0-9][a-z0-9._-]{0,127}$"
    }
  }
}
