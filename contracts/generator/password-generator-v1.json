{
  "$schema": "password-generator-v1.schema.json",
  "schema_version": 1,
  "length": {"default":20,"minimum":8,"maximum":128},
  "classes": {
    "uppercase":"ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "lowercase":"abcdefghijklmnopqrstuvwxyz",
    "numbers":"0123456789",
    "symbols":"!@#$%^&*()-_=+[]{}:,.?"
  },
  "selection": "unbiased-rejection-sampling",
  "random_source": "client-OS-CSPRNG",
  "empty_alphabet": "reject",
  "output_handling": "client-only-secret"
}
