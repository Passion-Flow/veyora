{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyora.invalid/contracts/generator/password-generator-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "length", "classes", "selection", "random_source", "empty_alphabet", "output_handling"],
  "properties": {
    "schema_version": {"const": 1},
    "length": {"type": "object"},
    "classes": {"type": "object"},
    "selection": {"const": "unbiased-rejection-sampling"},
    "random_source": {"const": "client-OS-CSPRNG"},
    "empty_alphabet": {"const": "reject"},
    "output_handling": {"const": "client-only-secret"}
  }
}
