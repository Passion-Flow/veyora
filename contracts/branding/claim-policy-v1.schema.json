{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://veyora.invalid/contracts/branding/claim-policy-v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","categories","availability_states","prohibited_phrases","claims"],
  "properties":{
    "schema_version":{"const":1},
    "categories":{"type":"array","minItems":5,"uniqueItems":true,"items":{"enum":["PROMOTE","PROMOTE_WITH_EVIDENCE_QUALIFIER","AVAILABLE_BUT_DO_NOT_LEAD","ROADMAP_DO_NOT_PROMISE","PROHIBITED_CLAIM"]}},
    "availability_states":{"type":"array","minItems":5,"uniqueItems":true,"items":{"enum":["DESIGNED","IMPLEMENTED","EVIDENCED-CANDIDATE","PUBLISHED","WITHDRAWN"]}},
    "prohibited_phrases":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "claims":{"type":"array","minItems":1,"items":{"type":"object"}}
  }
}
