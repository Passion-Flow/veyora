ARG ENVOY_IMAGE=envoyproxy/envoy:v1.31.10
FROM ${ENVOY_IMAGE}
COPY deployment/envoy.yaml /etc/envoy/envoy.yaml
EXPOSE 8080 8443
# Configuration is rendered from environment variables at container start and
# every variable is REQUIRED (fail fast with a clear message, no defaults).
# The full documented set lives in .env.example.
#
# TLS mode: when VEYORA_GATEWAY_TLS_CERT_FILE is set, the gateway terminates
# TLS on VEYORA_GATEWAY_TLS_PORT (default 8443) and redirects HTTP→HTTPS on
# VEYORA_GATEWAY_HTTP_PORT (default 8080). Without certificates, the gateway
# runs as a plain HTTP proxy on VEYORA_GATEWAY_HTTP_PORT (no redirect).
ENTRYPOINT ["/bin/bash", "-c", "\
  : \"${VEYORA_GATEWAY_HTTP_PORT:=8080}\"; \
  : \"${VEYORA_API_UPSTREAM_HOST:?VEYORA_API_UPSTREAM_HOST is required}\"; \
  : \"${VEYORA_API_UPSTREAM_PORT:?VEYORA_API_UPSTREAM_PORT is required}\"; \
  : \"${VEYORA_GATEWAY_ROUTE_TIMEOUT_SECONDS:?VEYORA_GATEWAY_ROUTE_TIMEOUT_SECONDS is required}\"; \
  if [ -n \"${VEYORA_GATEWAY_TLS_CERT_FILE}\" ] && [ -n \"${VEYORA_GATEWAY_TLS_KEY_FILE}\" ]; then \
    : \"${VEYORA_GATEWAY_TLS_PORT:=8443}\"; \
    if [ ! -f \"${VEYORA_GATEWAY_TLS_CERT_FILE}\" ]; then \
      echo \"veyora-gateway: TLS certificate not found: ${VEYORA_GATEWAY_TLS_CERT_FILE}\" >&2; exit 1; \
    fi; \
    if [ ! -f \"${VEYORA_GATEWAY_TLS_KEY_FILE}\" ]; then \
      echo \"veyora-gateway: TLS private key not found: ${VEYORA_GATEWAY_TLS_KEY_FILE}\" >&2; exit 1; \
    fi; \
    echo \"veyora-gateway: TLS enabled on :${VEYORA_GATEWAY_TLS_PORT}, HTTP redirect on :${VEYORA_GATEWAY_HTTP_PORT}\" >&2; \
    sed -i -e \"s/__VEYORA_GATEWAY_TLS_PORT__/${VEYORA_GATEWAY_TLS_PORT}/g\" \
           -e \"s/__VEYORA_GATEWAY_HTTP_PORT__/${VEYORA_GATEWAY_HTTP_PORT}/g\" \
           -e \"s|__VEYORA_GATEWAY_TLS_CERT_FILE__|${VEYORA_GATEWAY_TLS_CERT_FILE}|g\" \
           -e \"s|__VEYORA_GATEWAY_TLS_KEY_FILE__|${VEYORA_GATEWAY_TLS_KEY_FILE}|g\" \
           -e \"s/__VEYORA_API_UPSTREAM_HOST__/${VEYORA_API_UPSTREAM_HOST}/g\" \
           -e \"s/__VEYORA_API_UPSTREAM_PORT__/${VEYORA_API_UPSTREAM_PORT}/g\" \
           -e \"s/__VEYORA_GATEWAY_ROUTE_TIMEOUT_SECONDS__/${VEYORA_GATEWAY_ROUTE_TIMEOUT_SECONDS}/g\" \
           /etc/envoy/envoy.yaml; \
  else \
    echo \"veyora-gateway: TLS disabled, plain HTTP proxy on :${VEYORA_GATEWAY_HTTP_PORT}\" >&2; \
    printf 'static_resources:\n  listeners:\n    - name: plain_http\n      address:\n        socket_address:\n          address: 0.0.0.0\n          port_value: %s\n      filter_chains:\n        - filters:\n            - name: envoy.filters.network.http_connection_manager\n              typed_config:\n                \"@type\": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager\n                stat_prefix: plain_http\n                route_config:\n                  virtual_hosts:\n                    - name: proxy\n                      domains: [\"*\"]\n                      routes:\n                        - match: { prefix: \"/\" }\n                          route:\n                            cluster: upstream\n                            timeout: %ss\n                http_filters:\n                  - name: envoy.filters.http.router\n                    typed_config:\n                      \"@type\": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router\n  clusters:\n    - name: upstream\n      type: LOGICAL_DNS\n      lb_policy: ROUND_ROBIN\n      load_assignment:\n        cluster_name: upstream\n        endpoints:\n          - lb_endpoints:\n              - endpoint:\n                  address:\n                    socket_address:\n                      address: %s\n                      port_value: %s\n' \"${VEYORA_GATEWAY_HTTP_PORT}\" \"${VEYORA_GATEWAY_ROUTE_TIMEOUT_SECONDS}\" \"${VEYORA_API_UPSTREAM_HOST}\" \"${VEYORA_API_UPSTREAM_PORT}\" > /etc/envoy/envoy.yaml; \
  fi && \
  exec envoy -c /etc/envoy/envoy.yaml --log-level warn"]
