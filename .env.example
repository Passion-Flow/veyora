# Veyora local-preview configuration
# Copy this file to .env and set a unique development password before starting.

VEYORA_DB_PASSWORD=
VEYORA_DB_NAME=veyora
VEYORA_DB_USER=veyora
VEYORA_DB_PORT=5432

# Localhost-only published ports.
VEYORA_GATEWAY_PORT=8080
VEYORA_WEB_PORT=3000

# Explicit service configuration.
VEYORA_API_AUTH=disabled
# Add VEYORA_API_TOKEN when VEYORA_API_AUTH is set to token.
VEYORA_API_MAX_BODY_BYTES=262144
VEYORA_WORKER_POLL_SECONDS=60
VEYORA_GATEWAY_ROUTE_TIMEOUT_SECONDS=30
VEYORA_WEB_PROXY_TIMEOUT_SECONDS=30

# Public multi-architecture image source. Every application and runtime
# foundation uses the same version. Docker automatically selects linux/amd64
# or linux/arm64 behind the shared tag; no registry login is required.
REGISTRY=ghcr.io
NAMESPACE=passion-flow
VERSION=v1.0.0

# Security hardening (production)
# Comma-separated origin allowlist; empty = permissive wildcard (dev only)
# VEYORA_API_CORS_ORIGINS=https://vault.example.com
# Requests per minute per IP (0 = disabled; recommended: 120)
# VEYORA_API_RATE_LIMIT=120
