# ==================================================================
# Essential defaults for the Veyora Docker Compose deployment.
#
# Copy this file to `.env` (in this directory) and adjust the values:
#   cp .env.example .env
#   docker compose up -d
#
# Only variables required to start the stack live here. Optional
# hardening (TLS, CORS, rate limiting) is included as commented
# entries — uncomment and set them for any non-loopback deployment.
# ==================================================================

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------

# PostgreSQL password. Generate a unique value, for example:
#   openssl rand -hex 32
VEYORA_DB_PASSWORD=

# Database name and role. The defaults match the container defaults
# and rarely need to change.
VEYORA_DB_NAME=veyora
VEYORA_DB_USER=veyora

# Host port (loopback-only) under which PostgreSQL is published.
# Used by local Rust development (`make run-db`); irrelevant when the
# stack runs standalone.
VEYORA_DB_PORT=5432

# ------------------------------------------------------------------
# Published ports (all loopback-only)
# ------------------------------------------------------------------

# Gateway plain-HTTP port and web client port on the host.
VEYORA_GATEWAY_PORT=8080
VEYORA_WEB_PORT=3000

# ------------------------------------------------------------------
# API service
# ------------------------------------------------------------------

# Authentication mode for the API:
#   disabled — local preview only; anyone reaching the port has access
#   token    — requires VEYORA_API_TOKEN on every request (Bearer)
# Any deployment beyond the local machine must use `token`.
VEYORA_API_AUTH=disabled

# Shared bearer token when VEYORA_API_AUTH=token. Generate with:
#   openssl rand -hex 32
# VEYORA_API_TOKEN=

# Maximum accepted request body size in bytes.
VEYORA_API_MAX_BODY_BYTES=262144

# Worker polling interval in seconds.
VEYORA_WORKER_POLL_SECONDS=60

# ------------------------------------------------------------------
# Timeouts
# ------------------------------------------------------------------

# Gateway route timeout and web proxy timeout in seconds.
VEYORA_GATEWAY_ROUTE_TIMEOUT_SECONDS=30
VEYORA_WEB_PROXY_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------
# Image source
# ------------------------------------------------------------------

# Public multi-architecture image source. Every application and runtime
# foundation uses the same version; Docker selects linux/amd64 or
# linux/arm64 automatically. No registry login is required.
REGISTRY=ghcr.io
NAMESPACE=passion-flow
VERSION=v1.0.0

# Override the PostgreSQL image entirely (for example
# VEYORA_POSTGRES_IMAGE=postgres:16-bookworm for source-build workflows
# that do not use the mirrored foundation).
# VEYORA_POSTGRES_IMAGE=

# ------------------------------------------------------------------
# TLS termination (gateway) — optional
# ------------------------------------------------------------------

# Path to the certificate chain and key INSIDE the gateway container.
# The host directory mounted at /certs is controlled by
# VEYORA_TLS_CERT_DIR below. When both files are set, the gateway
# terminates TLS on VEYORA_GATEWAY_TLS_PORT and redirects HTTP to
# HTTPS. Leave unset for plain-HTTP local preview.
# VEYORA_GATEWAY_TLS_CERT_FILE=/certs/fullchain.pem
# VEYORA_GATEWAY_TLS_KEY_FILE=/certs/privkey.pem
# VEYORA_TLS_CERT_DIR=./certs
# Host port for TLS (defaults to 8443; use 443 for public deployments).
# VEYORA_GATEWAY_TLS_PORT=443

# ------------------------------------------------------------------
# Security hardening — optional
# ------------------------------------------------------------------

# Comma-separated origin allowlist for the API; empty = permissive
# wildcard (development only). Recommended for reviewed deployments:
# VEYORA_API_CORS_ORIGINS=https://vault.example.com

# Requests per minute per client IP (0 = disabled; recommended: 120).
# VEYORA_API_RATE_LIMIT=120
